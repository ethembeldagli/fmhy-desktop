{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FMHY Desktop",
  "version": "0.1.0",
  "identifier": "org.unofficial.fmhydesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421 https://api.fmhy.net https://raw.githubusercontent.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Unofficial third-party client. Not affiliated with or endorsed by FMHY.",
    "category": "Utility",
    "shortDescription": "Unofficial desktop client for FMHY",
    "longDescription": "FMHY Desktop is an unofficial, third-party desktop application for browsing FMHY (FreeMediaHeckYeah). It is not affiliated with, endorsed by, or an official product of FMHY.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "web",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "release": "1",
        "epoch": 0
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "wix": {
        "language": [
          "en-US"
        ],
        "bannerPath": "installer/windows/banner.bmp",
        "dialogImagePath": "installer/windows/dialog.bmp"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/windows/header.bmp",
        "sidebarImage": "installer/windows/sidebar.bmp",
        "installMode": "both",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
